# Bu dosyayı .env.local olarak kopyalayın ve doldurun. .env.local git'e girmez.

# --- Veritabanı (SQLite) ---
# Kalıcı diskteki dosya yolu. Varsayılan: ./data/app.db
DATABASE_PATH=./data/app.db

# --- Better Auth ---
# En az 32 karakter, yüksek entropili. Üretmek için: npx auth@latest secret  veya  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Uygulamanın dışarıdan erişilen adresi (davet bağlantıları da bununla üretilir).
BETTER_AUTH_URL=http://localhost:3000
# Oturum çerezleri her zaman Secure işaretlidir; localhost dışında düz HTTP ile geliştirme yapıyorsanız true yapın.
AUTH_INSECURE_COOKIES=false

# --- Google Places API (New) — YALNIZCA SUNUCUDA ---
# Google Cloud Console → API'ler ve Hizmetler → Kimlik bilgileri. Yalnızca "Places API (New)" ile kısıtlayın;
# uygulama kısıtlaması olarak sunucunun IP adresini verin. Bu anahtar tarayıcıya asla gönderilmez.
GOOGLE_PLACES_API_KEY=
# true iken Places'a hiç istek atılmaz; örnek (sahte) işletmeler döner. Anahtarsız geliştirme için.
PLACES_MOCK=true
# Tarama başına en fazla Places isteği.
SCAN_MAX_REQUESTS=50
# Yeni çalışma alanlarının aylık Places kotası, BİRİM cinsinden (varsayılan 6000; ağırlıklar Ayarlar'da ve
# src/lib/places-birimleri.ts'de). Ay, İstanbul saatine göre değişir. Mevcut alanlar için: npm run kota -- <slug> <sayı>
PLACES_AYLIK_KOTA=6000

# --- Mesajlaşma (e-posta / SMS kampanyaları, WhatsApp listesi) — YALNIZCA SUNUCUDA ---
# İkisi de 32 baytlık rastgele değer (base64). Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sağlayıcı (SMTP) kimlik bilgilerinin AES-256-GCM şifreleme anahtarı. Değişirse kayıtlı bilgiler yeniden girilmeli.
ILETI_SIFRELEME_ANAHTARI=
# Abonelikten çıkma bağlantısı imzası ve engel listesi özetleri. DEĞİŞTİRMEYİN: eski bağlantılar geçersiz olur,
# engel listesi eşleşmez (ret vermiş adreslere yeniden gönderim riski).
ILETI_IMZA_ANAHTARI=
# Çalışma alanı başına günlük gönderim sınırı (İstanbul günü). Alan bazında: npm run sinir -- <slug> <kanal> <sayı>
GUNLUK_EPOSTA_SINIRI=300
GUNLUK_SMS_SINIRI=200
# Kullanıcı başına günlük WhatsApp sınırı varsayılanı (en fazla 50). Alan bazında Ayarlar'dan.
WHATSAPP_GUNLUK_VARSAYILAN=30
# Netgsm API kök adresi (yalnızca test/sahte sunucu için değiştirin).
# NETGSM_API_URL=https://api.netgsm.com.tr
# WhatsApp Business Platform (Cloud API): Graph API sürümü. Bağlantı bilgileri Ayarlar'dan girilir (şifreli saklanır).
META_GRAPH_SURUMU=v26.0
# Graph API kök adresi (yalnızca test için; https zorunlu).
# META_GRAPH_URL=https://graph.facebook.com
# 1: geliştirmede gerçek Meta yerine sahte istemci (testler her zaman sahte kullanır).
# WHATSAPP_API_MOCK=1
# WhatsApp (Cloud API) kampanyaları: çalışma alanı başına günlük üst sınır ve saniyede en fazla gönderim.
GUNLUK_WHATSAPP_API_SINIRI=1000
WHATSAPP_SANIYE_BASI=20
# Gönderim işçisi (npm run worker): tur aralığı (sn) ve tur başına en fazla mesaj.
WORKER_ARALIK_SN=30
WORKER_PARTI=20
# Tek işçi kilidinin süresi (sn); tur boyunca uzatılır, çöken işçinin kilidi bu süre sonunda düşer.
ISCI_KILIT_SN=120

# --- Google Maps JavaScript API — TARAYICI ---
# AYRI bir anahtar: yalnızca "Maps JavaScript API" ile ve HTTP referrer (alan adınız) ile kısıtlayın.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Gelişmiş işaretçiler için Map ID (Google Cloud → Harita yönetimi). Boşsa DEMO_MAP_ID kullanılır.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
