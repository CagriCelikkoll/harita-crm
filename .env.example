# Bu dosyayı .env.local olarak kopyalayın ve doldurun. .env.local git'e girmez.

# --- Veritabanı (SQLite) ---
# Kalıcı diskteki dosya yolu. Varsayılan: ./data/app.db
DATABASE_PATH=./data/app.db

# --- Better Auth ---
# En az 32 karakter, yüksek entropili. Üretmek için: npx auth@latest secret  veya  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Uygulamanın dışarıdan erişilen adresi (davet bağlantıları da bununla üretilir).
BETTER_AUTH_URL=http://localhost:3000
# Oturum çerezleri her zaman Secure işaretlidir; localhost dışında düz HTTP ile geliştirme yapıyorsanız true yapın.
AUTH_INSECURE_COOKIES=false

# --- Google Places API (New) — YALNIZCA SUNUCUDA ---
# Google Cloud Console → API'ler ve Hizmetler → Kimlik bilgileri. Yalnızca "Places API (New)" ile kısıtlayın;
# uygulama kısıtlaması olarak sunucunun IP adresini verin. Bu anahtar tarayıcıya asla gönderilmez.
GOOGLE_PLACES_API_KEY=
# true iken Places'a hiç istek atılmaz; örnek (sahte) işletmeler döner. Anahtarsız geliştirme için.
PLACES_MOCK=true
# Tarama başına en fazla Places isteği.
SCAN_MAX_REQUESTS=50
# Yeni çalışma alanlarının aylık Places isteği kotası (varsayılan 2000). Mevcut alanlar için: npm run kota -- <slug> <sayı>
PLACES_AYLIK_KOTA=2000

# --- Google Maps JavaScript API — TARAYICI ---
# AYRI bir anahtar: yalnızca "Maps JavaScript API" ile ve HTTP referrer (alan adınız) ile kısıtlayın.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Gelişmiş işaretçiler için Map ID (Google Cloud → Harita yönetimi). Boşsa DEMO_MAP_ID kullanılır.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
