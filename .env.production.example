# Canlı sunucu ortam dosyası şablonu. Sunucuda:
#   sudo -u harita cp /opt/harita-crm/.env.production.example /opt/harita-crm/.env.production.local
#   sudo -u harita chmod 600 /opt/harita-crm/.env.production.local
#   sudo -u harita -H bash -c 'cd /opt/harita-crm && npm run anahtar:uret -- .env.production.local'
# Next.js (derleme ve çalışma) ve tüm scriptler (işçi, migration, yedek) bu dosyayı okur; git'e girmez.
# NEXT_PUBLIC_* değerleri DERLEME anında sayfaya gömülür: değiştirirseniz sudo bash /opt/harita-crm/deploy/guncelle.sh --zorla.
# Ayrıntı: docs/SUNUCU-KURULUM.md

# --- Veri ---
DATABASE_PATH=/var/lib/harita-crm/app.db
# Günlük yedekler (npm run yedek; 14 gün saklanır). Sağlık ucu son yedeğin yaşını buradan denetler.
YEDEK_KLASORU=/var/backups/harita-crm
# Gelen WhatsApp fotoğraf, belge ve sesleri. Boşsa veritabanının klasöründe "medya" (/var/lib/harita-crm/medya).
# MEDYA_KLASORU=

# --- Adres ve oturum ---
BETTER_AUTH_URL=https://deneme.bursalidagitim.com
# Meta webhook adresi aynı alan adından üretilir (canlıda tünel yok).
GENEL_ADRES=https://deneme.bursalidagitim.com
# Üretimde bu alan adları dışındaki Host'a (ör. sunucunun IP adresi) 404 döner. Boşsa BETTER_AUTH_URL'in alanı.
UYGULAMA_ALANLARI=deneme.bursalidagitim.com
AUTH_INSECURE_COOKIES=false
# davetle: yalnızca ilk yönetici (aşağıdaki e-posta, hiç kullanıcı yokken) ve geçerli daveti olanlar kayıt olur.
KAYIT_KIPI=davetle
ILK_YONETICI_EPOSTASI=

# --- Gizli anahtarlar: npm run anahtar:uret doldurur (ekrana yazmaz). DOLDUKTAN SONRA DEĞİŞTİRMEYİN. ---
# BETTER_AUTH_SECRET değişirse herkesin oturumu kapanır.
BETTER_AUTH_SECRET=
# Değişirse kayıtlı SMTP/Netgsm/WhatsApp bilgileri çözülemez, yeniden girilmesi gerekir.
ILETI_SIFRELEME_ANAHTARI=
# Değişirse engel listesi eşleşmez (ret vermiş kişiye yeniden gönderim riski) ve eski abonelik bağlantıları bozulur.
ILETI_IMZA_ANAHTARI=

# --- Google Places API (New) — YALNIZCA SUNUCU ---
# Google Cloud'da anahtarı "Places API (New)" ve sunucunun IP adresiyle kısıtlayın.
GOOGLE_PLACES_API_KEY=
PLACES_MOCK=false
SCAN_MAX_REQUESTS=50
PLACES_AYLIK_KOTA=30000

# --- Google Maps JavaScript API — TARAYICI (derlemede gömülür) ---
# Ayrı anahtar: yalnızca "Maps JavaScript API" ve HTTP referrer https://deneme.bursalidagitim.com/* ile kısıtlayın.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Mesajlaşma ---
GUNLUK_EPOSTA_SINIRI=300
GUNLUK_SMS_SINIRI=200
WHATSAPP_GUNLUK_VARSAYILAN=30
META_GRAPH_SURUMU=v26.0
# WHATSAPP_API_MOCK canlıda TANIMLANMAZ (tanımlıysa gerçek Meta yerine sahte istemci çalışır).
GUNLUK_WHATSAPP_API_SINIRI=1000
WHATSAPP_SANIYE_BASI=20

# --- Gönderim işçisi ---
WORKER_ARALIK_SN=30
WORKER_PARTI=20
ISCI_KILIT_SN=120
